{
  "name": "istar-ts-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "dev": "pnpm --filter playground dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter playground e2e",
    "e2e:headed": "pnpm --filter playground e2e:headed",
    "e2e:ui": "pnpm --filter playground e2e:ui",
    "typecheck": "pnpm -r typecheck && tsc -p test-support/tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "changelog:release": "node scripts/changelog-release.mjs",
    "check:dist": "node scripts/check-dist-imports.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
