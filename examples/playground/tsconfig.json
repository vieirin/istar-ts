{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // `@istar-ts/glsp` (glsp.html only) uses Inversify's legacy decorators.
    "experimentalDecorators": true,
    "isolatedDeclarations": false,
    "declaration": false
  },
  "include": ["src", "vite.config.ts", "e2e", "playwright.config.ts", "../../test-support"]
}
