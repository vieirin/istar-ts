{
  "name": "@istar-ts/glsp",
  "version": "0.0.0-development",
  "description": "A GLSP server for istar-ts models, on @eclipse-glsp/server: GModel, diagram configuration, dialect contributions, and Web Worker, in-page (MCP) and Node (WebSocket, MCP) launchers. Never depends on React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/node.ts",
    "./src/browser.ts",
    "./src/serve.ts",
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/node.js",
    "./dist/node.cjs",
    "./dist/browser.js",
    "./dist/browser.cjs",
    "./dist/serve.js"
  ],
  "keywords": [
    "istar",
    "istar2",
    "goal-model",
    "glsp",
    "pistar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vieirin/istar-ts.git",
    "directory": "packages/glsp"
  },
  "exports": {
    ".": {
      "@istar-ts/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./kaos": {
      "@istar-ts/source": "./src/kaos.ts",
      "import": {
        "types": "./dist/kaos.d.ts",
        "default": "./dist/kaos.js"
      },
      "require": {
        "types": "./dist/kaos.d.cts",
        "default": "./dist/kaos.cjs"
      }
    },
    "./nfr": {
      "@istar-ts/source": "./src/nfr.ts",
      "import": {
        "types": "./dist/nfr.d.ts",
        "default": "./dist/nfr.js"
      },
      "require": {
        "types": "./dist/nfr.d.cts",
        "default": "./dist/nfr.cjs"
      }
    },
    "./node": {
      "@istar-ts/source": "./src/node.ts",
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./browser": {
      "@istar-ts/source": "./src/browser.ts",
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./page": {
      "@istar-ts/source": "./src/page.ts",
      "import": {
        "types": "./dist/page.d.ts",
        "default": "./dist/page.js"
      },
      "require": {
        "types": "./dist/page.d.cts",
        "default": "./dist/page.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "serve": "pnpm --filter \"@istar-ts/glsp...\" build && node dist/serve.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "prepack": "cp ../../LICENSE . && pnpm build"
  },
  "dependencies": {
    "@eclipse-glsp/server": "^2.8.0",
    "@istar-ts/actions": "workspace:^",
    "@istar-ts/core": "workspace:^",
    "@istar-ts/gmodel": "workspace:^",
    "inversify": "^6.2.2",
    "reflect-metadata": "^0.2.2",
    "vscode-jsonrpc": "8.2.0"
  },
  "peerDependencies": {
    "@istar-ts/dsm3-kaos": "workspace:^",
    "@istar-ts/dsm3-nfr": "workspace:^",
    "@eclipse-glsp/server-mcp": "2.8.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@istar-ts/dsm3-kaos": {
      "optional": true
    },
    "@istar-ts/dsm3-nfr": {
      "optional": true
    },
    "@eclipse-glsp/server-mcp": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eclipse-glsp/server-mcp": "2.8.0",
    "@istar-ts/dsm3-kaos": "workspace:^",
    "@istar-ts/dsm3-nfr": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "vite": "^6.4.3",
    "zod": "^4.0.0"
  }
}
