{
  "name": "@istar-ts/agent",
  "version": "0.0.0-development",
  "description": "A framework-free tool-calling loop between an OpenAI-compatible chat model and istar-ts tools (MCP or @istar-ts/actions), with propose/auto approval and a key-free transcript.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "istar",
    "istar2",
    "goal-model",
    "agent",
    "llm",
    "tool-calling",
    "mcp",
    "pistar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vieirin/istar-ts.git",
    "directory": "packages/agent"
  },
  "exports": {
    ".": {
      "@istar-ts/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "prepack": "cp ../../LICENSE . && pnpm build"
  },
  "dependencies": {
    "@istar-ts/actions": "workspace:^",
    "@istar-ts/core": "workspace:^"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
