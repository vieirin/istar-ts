{
  "name": "@istar-ts/react",
  "version": "0.1.0",
  "description": "React components for editing iStar 2.0 goal models, built on React Flow with a pluggable element registry.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "istar",
    "istar2",
    "goal-model",
    "react",
    "react-flow",
    "pistar",
    "diagram"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vieirin/istar-ts.git",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "@istar-ts/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "prepack": "cp ../../LICENSE . && pnpm build"
  },
  "dependencies": {
    "@istar-ts/core": "workspace:^",
    "@xyflow/react": "^12.12.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
